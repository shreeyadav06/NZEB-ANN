# GitHub Linguist Overrides
# Exclude LaTeX templates, styles, bibliography, and manuscript from repo language stats
research[[:space:]]paper/** linguist-vendored -linguist-detectable
research?paper/** linguist-vendored -linguist-detectable
*.cls linguist-vendored -linguist-detectable
*.bst linguist-vendored -linguist-detectable
*.sty linguist-vendored -linguist-detectable
*.tex linguist-vendored -linguist-detectable
*.bib linguist-vendored -linguist-detectable
*.mmd linguist-vendored -linguist-detectable
